{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		// MARK: Editor Defaults
		"editor.copyWithSyntaxHighlighting": false,
		"editor.lightbulb.enabled": "off",
		"editor.formatOnSave": true,
		"editor.smoothScrolling": true,
		"editor.cursorSmoothCaretAnimation": "on",
		"editor.scrollbar.horizontal": "hidden",
		"editor.wordWrap": "on",
		"editor.wrappingStrategy": "advanced",
		"editor.tabSize": 2,
		"editor.fontSize": 15,
		"editor.lineHeight": 1.4,
		"editor.fontLigatures": true,
		"files.insertFinalNewline": true,
		"files.trimTrailingWhitespace": true,
		"explorer.confirmDelete": false,
		"explorer.compactFolders": false,
		"workbench.sideBar.location": "left",
		"git.enableCommitSigning": true,
		// MARK: Noise Reduction
		"editor.hover.enabled": true,
		"workbench.tips.enabled": false,
		"git.decorations.enabled": false,
		"explorer.decorations.colors": true,
		"explorer.decorations.badges": false,
		"editor.renderLineHighlight": "none",
		"editor.occurrencesHighlight": "off",
		"editor.gotoLocation.multipleReferences": "goto",
		"editor.gotoLocation.multipleDefinitions": "goto",
		"editor.gotoLocation.multipleDeclarations": "goto",
		"editor.gotoLocation.multipleImplementations": "goto",
		"editor.gotoLocation.multipleTypeDefinitions": "goto",
		// MARK: Search Settings
		"search.useIgnoreFiles": false,
		"search.exclude": {
			"**/node_modules": true,
			"**/dist": true,
			"**debug": true,
			"**/package-lock.json": true,
			"**/.next": true,
			"**/data": true
		},
		// MARK: Suggestions
		"editor.suggestFontSize": 12,
		"editor.suggestLineHeight": 25,
		// MARK: Terminal Settings
		"terminal.integrated.lineHeight": 1.3,
		"terminal.integrated.fontSize": 13,
		// MARK: TypeScript Settings
		"typescript.tsdk": "node_modules/typescript/lib",
		"typescript.enablePromptUseWorkspaceTsdk": true,
		// MARK: Custom Labels
		"workbench.editor.customLabels.patterns": {
			// App router
			"**/app/*.tsx": "${filename}.${extname} (root)",
			"**/app/**/index.*": "${dirname}(${filename}.${extname})",
			"**/app/**/page.{*}": "${dirname} ∙ page",
			"**/app/**/[[]*[]]/page.{*}": "${dirname(1)} / ${dirname} ∙ page",
			"**/app/**/[[]*[]]/[[]*[]]/page.{*}": "${dirname(2)} / ${dirname(1)} / ${dirname} ∙ page",
			"**/app/**/layout.{*}": "${dirname} ∙ (${dirname(1)}) ∙ layout",
			"**/app/**/template.{*}": "${dirname} ∙ (${dirname(1)}) ∙ template",
			"**/app/api/**/route.ts": "${dirname(1)}/${dirname} ∙ api",
			// Components
			"**/components/**/index.tsx": "${dirname} ∙ (${dirname(1)})component",
			"**/components/**/*.tsx": "${filename} ∙ (${dirname(1)})component",
			"**/components/**/*.*": "${filename}.${extname} ∙ ${dirname}(${dirname(1)})component",
			// Others
			"**/utils/index.*": "🧰 ∙ index",
			"**/utils/*.*": "🧰 ∙ ${filename}.${extname}",
			"**/hooks/*.{ts,tsx,js,jsx}": "🪝 ∙ ${filename}.${extname}"
		},
		// MARK: Formatting
		"editor.defaultFormatter": "biomejs.biome",
		"[typescriptreact]": {
			"editor.defaultFormatter": "biomejs.biome"
		},
		"[jsonc]": {
			"editor.defaultFormatter": "vscode.json-language-features"
		},
		// MARK: CodeLens
		"editor.codeLens": true,
		"diffEditor.codeLens": true,
		"javascript.referencesCodeLens.enabled": true,
		"javascript.referencesCodeLens.showOnAllFunctions": true,
		"typescript.implementationsCodeLens.enabled": true,
		"typescript.implementationsCodeLens.showOnInterfaceMethods": true,
		"typescript.referencesCodeLens.enabled": true,
		"typescript.referencesCodeLens.showOnAllFunctions": true,
		// MARK: Auto Lock Groups
		"workbench.editor.autoLockGroups": {
			"mainThreadWebview-browserPreview": false,
			"workbench.editorinputs.searchEditorInput": true
		},
		"[markdown]": {
			"editor.defaultFormatter": "yzhang.markdown-all-in-one"
		}
	},
	"extensions": {
		"recommendations": [
			"biomejs.biome",
			"eamodio.gitlens",
			"gruntfuggly.todo-tree",
			"bradlc.vscode-tailwindcss",
			"shubhamverma18.react-outline",
			"aaron-bond.better-comments"
		]
	}
}
